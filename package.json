{
  "name": "ts-react-quality-lens",
  "version": "0.3.0",
  "description": "Reusable TypeScript and React quality measurement artifacts for project-management-board.",
  "type": "module",
  "main": "./dist/src/cli.js",
  "bin": {
    "ts-react-quality-lens": "./dist/bin/ts-react-quality-lens.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run typecheck && npm run build && node dist/scripts/schema-check.js && node dist/scripts/rule-contract-check.js && node dist/scripts/format-check.js && node --test \"dist/test/*.test.js\" && node dist/scripts/perf-smoke.js && node dist/scripts/package-smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "schema:check": "npm run build && node dist/scripts/schema-check.js",
    "rule:check": "npm run build && node dist/scripts/rule-contract-check.js",
    "perf:smoke": "npm run build && node dist/scripts/perf-smoke.js",
    "bench": "npm run build && node dist/scripts/bench.js",
    "package:smoke": "npm run build && node dist/scripts/package-smoke.js",
    "format:check": "npm run build && node dist/scripts/format-check.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "catalog": "npm run build && node ./dist/bin/ts-react-quality-lens.js catalog --config ./examples/basic/ts-react-quality-lens.config.json",
    "measure": "npm run build && node ./dist/bin/ts-react-quality-lens.js measure all --config ./examples/basic/ts-react-quality-lens.config.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist/",
    "src/",
    "bin/",
    "README.md",
    "tsconfig.json",
    "ts-react-quality-lens.schema.json",
    "ts-react-quality-lens.config.schema.json",
    "rule-contracts.json",
    "rule-contracts.schema.json"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "^4.2.5",
    "knip": "^6.32.2",
    "publint": "^0.3.24",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
