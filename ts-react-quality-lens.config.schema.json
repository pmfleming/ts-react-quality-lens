{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pmfleming/ts-react-quality-lens/ts-react-quality-lens.config.schema.json",
  "title": "ts-react-quality-lens config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project_name": { "type": "string" },
    "project_root": { "type": "string" },
    "source_roots": { "type": "array", "items": { "type": "string" } },
    "test_roots": { "type": "array", "items": { "type": "string" } },
    "output_dir": { "type": "string" },
    "tsconfig": { "type": "string" },
    "package_manager": { "type": "string" },
    "framework": { "type": "string" },
    "test_runner": { "type": "string" },
    "test_command": { "type": ["string", "null"] },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "layer_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "patterns"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string" },
          "patterns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "performance_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle_stats": { "type": "string" },
        "render_costs": { "type": "string" }
      }
    },
    "public_api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "array", "items": { "type": "string" } },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "names"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "names": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "react": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ruleset": { "enum": ["classic-v1", "recommended-v2"] }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "components": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "polymorphic_prop_name": { "type": "string" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knip": { "type": "boolean" },
        "production": { "type": "boolean" }
      }
    },
    "type_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "per_file_minimum_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "changed_file_minimum_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "baseline": { "type": "string" }
      }
    },
    "package_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "attw_profile": { "enum": ["strict", "node16", "esm-only"] }
      }
    },
    "sarif_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "name": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["baseline", "recommended", "strict", "react", "library"] },
        "required_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["compiler", "typed-lint", "tests", "react-hooks", "package"] }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          { "required": ["id"] },
          { "required": ["file"] },
          { "required": ["kind"] }
        ],
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "kind": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string" },
        "changed_since": { "type": "string" },
        "gate": { "enum": ["new-only", "all"] },
        "baseline": { "type": "string" }
      }
    }
  }
}
