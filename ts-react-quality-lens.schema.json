{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pmfleming/ts-react-quality-lens/ts-react-quality-lens.schema.json",
  "title": "ts-react-quality-lens artifact",
  "type": "object",
  "required": ["schema_version", "task_id", "project", "provenance", "confidence", "summary"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "enum": [
        "audit",
        "context.project",
        "quality.hotspots",
        "quality.clones",
        "quality.escape_hatches",
        "quality.type_health",
        "quality.lint",
        "quality.locality_dynamic",
        "quality.locality_leverage",
        "quality.react_health",
        "quality.dependency_health",
        "quality.cleanup",
        "quality.sarif",
        "quality.runtime",
        "quality.modern_web",
        "quality.package_health",
        "correctness.catalog",
        "correctness.all",
        "testing.coverage",
        "map.architecture"
      ]
    },
    "project": {
      "type": "object",
      "required": ["name", "root"],
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "framework": { "type": "string" },
        "package_manager": { "type": "string" },
        "test_runner": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["lens", "schema_version", "command", "host", "measured_at", "source_type"],
      "properties": {
        "lens": { "const": "ts-react-quality-lens" },
        "schema_version": { "type": "string" },
        "command": { "type": "string" },
        "host": { "type": "string" },
        "measured_at": { "type": "string" },
        "source_type": { "type": "string" },
        "compilers": {
          "type": "object",
          "required": ["analysis", "native"],
          "properties": {
            "analysis": {
              "type": "object",
              "required": ["engine", "package", "version"],
              "properties": {
                "engine": { "const": "typescript-compiler-api" },
                "package": { "const": "typescript" },
                "version": { "type": "string" }
              },
              "additionalProperties": false
            },
            "native": {
              "type": "object",
              "required": ["package", "version", "role", "analysis_executed"],
              "properties": {
                "package": { "const": "@typescript/native" },
                "version": { "type": ["string", "null"] },
                "role": { "const": "lens-build-tool" },
                "analysis_executed": { "const": false }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "analysis_identity": {
      "type": "object",
      "required": ["id", "schema_version", "compiler_api_version", "config_closure_hash", "rulesets", "integration_versions"],
      "properties": {
        "id": { "type": "string" },
        "schema_version": { "type": "string" },
        "compiler_api_version": { "type": ["string", "null"] },
        "config_closure_hash": { "type": "string" },
        "rulesets": { "type": "object", "additionalProperties": { "type": "string" } },
        "integration_versions": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "react_support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workspace_id", "root", "declared_range", "range_source", "capabilities", "guidance"],
        "properties": {
          "workspace_id": { "type": "string" },
          "root": { "type": "string" },
          "declared_range": { "type": ["string", "null"] },
          "range_source": { "type": "string" },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "minimum_react", "support", "source"],
              "properties": {
                "id": { "type": "string" },
                "minimum_react": { "type": "string" },
                "support": { "enum": ["supported", "unsupported", "mixed", "unknown"] },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "guidance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability", "message", "source"],
              "properties": {
                "capability": { "type": "string" },
                "message": { "type": "string" },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "disagreements": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "unconfirmed": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/finding" },
          {
            "type": "object",
            "required": ["task_id", "introduced"],
            "properties": {
              "task_id": { "type": "string" },
              "introduced": { "type": "boolean" }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "quality.modern_web"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "inputs",
          "browser_data_versions",
          "browser_targets",
          "tool_status",
          "records",
          "limitations"
        ],
        "properties": {
          "inputs": {
            "type": "object",
            "required": [
              "fingerprint",
              "files",
              "skipped",
              "configuration_files"
            ],
            "properties": {
              "fingerprint": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "kind"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "script",
                        "html",
                        "css",
                        "manifest"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "skipped": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "reason"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "configuration_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "browser_data_versions": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "browser_targets": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/modernWebBrowserTargets"
            }
          },
          "tool_status": {
            "type": "object",
            "required": [
              "modern_web"
            ],
            "properties": {
              "modern_web": {
                "type": "object",
                "required": [
                  "status",
                  "available",
                  "ran",
                  "complete",
                  "reason",
                  "version",
                  "coverage",
                  "limitations"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "disabled",
                      "unavailable",
                      "failed",
                      "succeeded"
                    ]
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "ran": {
                    "type": "boolean"
                  },
                  "complete": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "coverage": {
                    "enum": [
                      "not_run",
                      "unknown"
                    ]
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/modernWebCandidate"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  ],
  "$defs": {
    "modernWebBrowserTargets": {
      "type": "object",
      "required": [
        "status",
        "workspace",
        "source",
        "environment",
        "queries",
        "resolved",
        "reason",
        "config_files"
      ],
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "unknown"
          ]
        },
        "workspace": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": "string"
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "modernWebCompatibility": {
      "type": "object",
      "required": [
        "status",
        "feature_ids",
        "unsupported_targets",
        "unknown_targets",
        "reason",
        "remediation",
        "guard"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "fallback_required",
            "incompatible",
            "unknown"
          ]
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "remediation": {
          "enum": [
            "review_replacement",
            "review_fallback",
            "withheld"
          ]
        },
        "guard": {
          "enum": [
            "observed",
            "not_observed",
            "not_assessed"
          ]
        }
      },
      "additionalProperties": true
    },
    "modernWebCandidate": {
      "type": "object",
      "required": [
        "source",
        "disposition",
        "evidence_kind",
        "semantic_decision",
        "contextual_verification",
        "guide_id",
        "guide_url",
        "upstream_message",
        "verification",
        "browser_targets",
        "compatibility"
      ],
      "properties": {
        "source": {
          "const": "modern-web-guidance"
        },
        "disposition": {
          "const": "review"
        },
        "evidence_kind": {
          "const": "heuristic"
        },
        "semantic_decision": {
          "const": "unresolved"
        },
        "contextual_verification": {
          "const": "pending"
        },
        "guide_id": {
          "type": "string"
        },
        "guide_url": {
          "type": "string"
        },
        "upstream_message": {
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "keepWhen",
                "dropWhen"
              ],
              "properties": {
                "keepWhen": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dropWhen": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "browser_targets": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/modernWebBrowserTargets"
            }
          ]
        },
        "compatibility": {
          "$ref": "#/$defs/modernWebCompatibility"
        }
      },
      "additionalProperties": true
    },
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "relatedLocation": {
      "type": "object",
      "required": ["file", "start_line", "role"],
      "properties": {
        "file": { "type": "string" },
        "start_line": { "type": "number", "minimum": 1 },
        "start_column": { "type": "number", "minimum": 1 },
        "end_line": { "type": "number", "minimum": 1 },
        "end_column": { "type": "number", "minimum": 1 },
        "role": { "enum": ["source", "sink", "cause", "related", "duplicate", "fix-site"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "rule_id", "evidence_kind", "disposition", "finding_confidence", "message"],
      "properties": {
        "id": { "type": "string" },
        "rule_id": { "type": "string" },
        "kind": { "type": "string" },
        "react_category": { "enum": ["correctness", "optimization", "configuration", "unknown", "tool-failure"] },
        "evidence_kind": { "enum": ["diagnostic", "tool-rule", "test", "metric", "heuristic"] },
        "disposition": { "enum": ["block", "warn", "review", "info"] },
        "finding_confidence": { "enum": ["low", "medium", "high"] },
        "message": { "type": "string" },
        "scope": { "enum": ["file", "project"] },
        "file": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "workspace_id": { "type": "string" },
        "workspace_name": { "type": "string" },
        "line": { "type": ["number", "null"] },
        "column": { "type": ["number", "null"] },
        "end_line": { "type": ["number", "null"] },
        "end_column": { "type": ["number", "null"] },
        "related_locations": { "type": "array", "items": { "$ref": "#/$defs/relatedLocation" } },
        "fix_group_id": { "type": "string" },
        "estimated_effort": { "type": "number", "minimum": 0 },
        "semantic_decision": { "enum": ["confirmed", "contract-preserved", "disagreed", "not-comparable", "excluded-by-tool", "unresolved", "abstained", "unavailable"] },
        "reason_code": { "type": "string" },
        "score": { "type": "number" },
        "risk": { "type": "string" },
        "severity": { "type": "string" },
        "suppressed": { "type": "boolean" },
        "suppression_reason": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string" },
              "value": { "type": ["string", "number", "boolean", "null"] },
              "line": { "type": ["number", "null"] },
              "specifier": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "auto_fixable", "description"],
            "properties": {
              "type": {
                "enum": ["fix", "suppress-line", "suppress-file", "add-to-config"]
              },
              "auto_fixable": { "type": "boolean" },
              "description": { "type": "string" },
              "fix": { "type": "string" },
              "comment": { "type": "string" },
              "config_key": { "type": "string" },
              "value": true,
              "note": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
