{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pmfleming/ts-react-quality-lens/ts-react-quality-lens.schema.json",
  "title": "ts-react-quality-lens artifact",
  "type": "object",
  "required": ["schema_version", "task_id", "project", "provenance", "confidence", "summary"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "enum": [
        "audit",
        "context.project",
        "quality.hotspots",
        "quality.clones",
        "quality.escape_hatches",
        "quality.type_health",
        "quality.lint",
        "quality.locality_dynamic",
        "quality.locality_leverage",
        "quality.react_health",
        "quality.dependency_health",
        "quality.cleanup",
        "quality.sarif",
        "quality.runtime",
        "quality.package_health",
        "correctness.catalog",
        "correctness.all",
        "map.architecture"
      ]
    },
    "project": {
      "type": "object",
      "required": ["name", "root"],
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "framework": { "type": "string" },
        "package_manager": { "type": "string" },
        "test_runner": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["lens", "schema_version", "command", "host", "measured_at", "source_type"],
      "properties": {
        "lens": { "const": "ts-react-quality-lens" },
        "schema_version": { "type": "string" },
        "command": { "type": "string" },
        "host": { "type": "string" },
        "measured_at": { "type": "string" },
        "source_type": { "type": "string" },
        "compilers": {
          "type": "object",
          "required": ["analysis", "native"],
          "properties": {
            "analysis": {
              "type": "object",
              "required": ["engine", "package", "version"],
              "properties": {
                "engine": { "const": "typescript-compiler-api" },
                "package": { "const": "typescript" },
                "version": { "type": "string" }
              },
              "additionalProperties": false
            },
            "native": {
              "type": "object",
              "required": ["package", "version", "role", "analysis_executed"],
              "properties": {
                "package": { "const": "@typescript/native" },
                "version": { "type": ["string", "null"] },
                "role": { "const": "lens-build-tool" },
                "analysis_executed": { "const": false }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "analysis_identity": {
      "type": "object",
      "required": ["id", "schema_version", "compiler_api_version", "config_closure_hash", "rulesets", "integration_versions"],
      "properties": {
        "id": { "type": "string" },
        "schema_version": { "type": "string" },
        "compiler_api_version": { "type": ["string", "null"] },
        "config_closure_hash": { "type": "string" },
        "rulesets": { "type": "object", "additionalProperties": { "type": "string" } },
        "integration_versions": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "react_support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workspace_id", "root", "declared_range", "range_source", "capabilities", "guidance"],
        "properties": {
          "workspace_id": { "type": "string" },
          "root": { "type": "string" },
          "declared_range": { "type": ["string", "null"] },
          "range_source": { "type": "string" },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "minimum_react", "support", "source"],
              "properties": {
                "id": { "type": "string" },
                "minimum_react": { "type": "string" },
                "support": { "enum": ["supported", "unsupported", "mixed", "unknown"] },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "guidance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability", "message", "source"],
              "properties": {
                "capability": { "type": "string" },
                "message": { "type": "string" },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "disagreements": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "unconfirmed": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/finding" },
          {
            "type": "object",
            "required": ["task_id", "introduced"],
            "properties": {
              "task_id": { "type": "string" },
              "introduced": { "type": "boolean" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "relatedLocation": {
      "type": "object",
      "required": ["file", "start_line", "role"],
      "properties": {
        "file": { "type": "string" },
        "start_line": { "type": "number", "minimum": 1 },
        "start_column": { "type": "number", "minimum": 1 },
        "end_line": { "type": "number", "minimum": 1 },
        "end_column": { "type": "number", "minimum": 1 },
        "role": { "enum": ["source", "sink", "cause", "related", "duplicate", "fix-site"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "rule_id", "evidence_kind", "disposition", "finding_confidence", "message"],
      "properties": {
        "id": { "type": "string" },
        "rule_id": { "type": "string" },
        "kind": { "type": "string" },
        "react_category": { "enum": ["correctness", "optimization", "configuration", "unknown", "tool-failure"] },
        "evidence_kind": { "enum": ["diagnostic", "tool-rule", "test", "metric", "heuristic"] },
        "disposition": { "enum": ["block", "warn", "review", "info"] },
        "finding_confidence": { "enum": ["low", "medium", "high"] },
        "message": { "type": "string" },
        "scope": { "enum": ["file", "project"] },
        "file": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "workspace_id": { "type": "string" },
        "workspace_name": { "type": "string" },
        "line": { "type": ["number", "null"] },
        "column": { "type": ["number", "null"] },
        "end_line": { "type": ["number", "null"] },
        "end_column": { "type": ["number", "null"] },
        "related_locations": { "type": "array", "items": { "$ref": "#/$defs/relatedLocation" } },
        "fix_group_id": { "type": "string" },
        "estimated_effort": { "type": "number", "minimum": 0 },
        "semantic_decision": { "enum": ["confirmed", "contract-preserved", "disagreed", "not-comparable", "excluded-by-tool", "unresolved", "abstained", "unavailable"] },
        "reason_code": { "type": "string" },
        "score": { "type": "number" },
        "risk": { "type": "string" },
        "severity": { "type": "string" },
        "suppressed": { "type": "boolean" },
        "suppression_reason": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string" },
              "value": { "type": ["string", "number", "boolean", "null"] },
              "line": { "type": ["number", "null"] },
              "specifier": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "auto_fixable", "description"],
            "properties": {
              "type": {
                "enum": ["fix", "suppress-line", "suppress-file", "add-to-config"]
              },
              "auto_fixable": { "type": "boolean" },
              "description": { "type": "string" },
              "fix": { "type": "string" },
              "comment": { "type": "string" },
              "config_key": { "type": "string" },
              "value": true,
              "note": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
